<?xml version="1.0" encoding="utf-8"?>
<!--
  Capital App — Adaptive Icon Descriptor
  ────────────────────────────────────────
  File : res/mipmap-anydpi-v26/ic_launcher.xml
         res/mipmap-anydpi-v26/ic_launcher_round.xml  (use same file for both)

  Requires : API 26+ (Android 8.0 Oreo)
  Layers   :
    background  → solid #0D7377 fill (ic_launcher_background)
    foreground  → white double-loop C mark (ic_launcher_foreground)
    monochrome  → reuses foreground layer for Android 13+ themed icons
                  (system will tint it automatically with wallpaper colours)
-->
<adaptive-icon
    xmlns:android="http://schemas.android.com/apk/res/android">

    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />

    <!-- Android 13+ (API 33): Material You monochrome themed icon -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />

</adaptive-icon>
